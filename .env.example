# Salesforce integration (Phase 3 - SalesforceRevenueGateway)
# Never commit real values. Obtain via `sf org display --json` against a
# permission-set-scoped integration user org, or a proper JWT/Client
# Credentials flow in production.
# Setting both variables switches the live agent from the mock gateway to Salesforce.
SF_INSTANCE_URL=
SF_ACCESS_TOKEN=

# Shared bearer token sent by the Salesforce Named Credential to the tools API
# (apps/web/app/api/tools/[toolName]). Required for that route to accept any
# request at all -- see docs/agentforce-setup.md.
TOOLS_API_KEY=
