# Copy to apps/web/.env (or set in your host's environment). Never commit real values.

# --- The live agent (required for chat) -------------------------------------------------
# Any OpenAI-compatible chat completions API. Defaults: OpenRouter and
# deepseek/deepseek-v4-flash-0731, which handles multi-step tool calling reliably and costs
# roughly $0.0003 per call. Small free models tend to stall mid-plan.
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# --- Sign-in cookies (required on a hosted deployment) ----------------------------------
# Encrypts the Salesforce session cookies. Use a long random value: `openssl rand -hex 32`.
# Locally, a random key per server process is used if unset.
SESSION_SECRET=

# --- Salesforce: sign in with OAuth (recommended) ---------------------------------------
# An External Client App per org (PKCE, no client secret); callback /api/auth/callback.
SF_OAUTH_CLIENT_ID=
SF_LOGIN_URL=https://login.salesforce.com
# Optional: pin the callback, e.g. on Vercel.
SF_OAUTH_REDIRECT_URI=
# The CPQ source org that the migration report inspects (Architect mode).
CPQ_OAUTH_CLIENT_ID=
CPQ_LOGIN_URL=https://login.salesforce.com

# --- Salesforce: static tokens (local development) --------------------------------------
# Visitors who haven't signed in use these when running locally. On a hosted deployment they
# are ignored for visitors (who get the built-in demo data) unless ALLOW_ANONYMOUS_ORG_ACCESS
# is true, which lets anyone with the URL act on this org: only for a private demo.
SF_INSTANCE_URL=
SF_ACCESS_TOKEN=
CPQ_INSTANCE_URL=
CPQ_ACCESS_TOKEN=
ALLOW_ANONYMOUS_ORG_ACCESS=

# --- Agentforce REST bridge (/api/tools) ------------------------------------------------
# Bearer keys sent by Salesforce Named Credentials. The bridge refuses every request without
# them. Catalog (Architect) tools use a separate key. See docs/agentforce-setup.md.
TOOLS_API_KEY=
CATALOG_TOOLS_API_KEY=

# --- Slack /quickpick (optional) ---------------------------------------------------------
# See apps/web/slack/manifest.template.json.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_LINK_SECRET=
# Vercel Blob store for linked Slack users' encrypted sessions.
BLOB_READ_WRITE_TOKEN=
